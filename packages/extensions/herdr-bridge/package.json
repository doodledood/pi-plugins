{
  "name": "@doodledood/pi-herdr-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi sessions in Herdr: start a separate interactive Pi session in its own Herdr tab, hear when it finishes, waits at a question, goes quiet or exits, and see dialog waits as blocked in Herdr.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr"
  ],
  "pi": {
    "extensions": [
      "./extensions/herdr-bridge/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test extensions/herdr-bridge/*.test.ts",
    "e2e": "tsx extensions/herdr-bridge/e2e/run.ts",
    "contract": "tsx extensions/herdr-bridge/e2e/contract.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "*",
    "tsx": "^4.22.4",
    "typebox": "*",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doodledood/pi-plugins.git",
    "directory": "packages/extensions/herdr-bridge"
  },
  "homepage": "https://github.com/doodledood/pi-plugins/tree/main/packages/extensions/herdr-bridge#readme",
  "bugs": {
    "url": "https://github.com/doodledood/pi-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "README.md",
    "package.json",
    "tsconfig.json"
  ]
}
