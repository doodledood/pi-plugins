{
  "name": "@doodledood/pi-tool-activity-renderer",
  "version": "0.5.2",
  "type": "module",
  "description": "Graphite-style rows for Pi's built-in file and shell tools, a live working line, and quieter thinking and narration.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test 'extensions/**/*.test.ts'"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/tool-activity-renderer.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doodledood/pi-plugins.git",
    "directory": "packages/extensions/tool-activity-renderer"
  },
  "homepage": "https://github.com/doodledood/pi-plugins/tree/main/packages/extensions/tool-activity-renderer#readme",
  "bugs": {
    "url": "https://github.com/doodledood/pi-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "config",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0"
  }
