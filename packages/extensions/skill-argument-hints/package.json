{
  "name": "@doodledood/pi-skill-argument-hints",
  "version": "0.1.4",
  "type": "module",
  "description": "Show argument-hint frontmatter as phantom hints for Pi skill commands.",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/skill-argument-hints.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test extensions/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doodledood/pi-plugins.git",
    "directory": "packages/extensions/skill-argument-hints"
  },
  "homepage": "https://github.com/doodledood/pi-plugins/tree/main/packages/extensions/skill-argument-hints#readme",
  "bugs": {
    "url": "https://github.com/doodledood/pi-plugins/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "README.md",
    "package.json",
    "tsconfig.json"
  ]
}
